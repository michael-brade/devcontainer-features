{
    "name": "DevContainer features",
    "image": "docker.io/library/debian:latest",

    "features": {
        "./src/essential-tools": {},
        "./src/bash-aliases": {}
    },

    "overrideFeatureInstallOrder": [
        "./src/essential-tools",
        "./src/bash-aliases"
    ],

    "runArgs": [
        "--name", "DevContainer-features-${devcontainerId}",
        "--network=host",
        "--userns=host"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "timonwong.shellcheck",
                "EditorConfig.EditorConfig"
            ]
        }
    },

    "mounts": [
        {
            "source": "/etc/localtime",
            "target": "/etc/localtime",
            "type": "bind"
        }
    ]
}
